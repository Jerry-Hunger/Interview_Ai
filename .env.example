# 必填：应用安全与 AI 服务配置
JWT_SECRET=
DEEPSEEK_API_KEY=

# 对外暴露的端口。修改 CLIENT_PORT 后，需同步修改下方 FRONTEND_URL。
CLIENT_PORT=8081
SERVER_PORT=5000
MONGODB_PORT=27017

# 可选：DeepSeek 请求超时（毫秒）与失败重试次数；未配置时分别为 60000 和 2。
DEEPSEEK_TIMEOUT=
DEEPSEEK_MAX_RETRIES=

# Docker Compose 默认连接内置 MongoDB；使用 Atlas 时改为对应连接字符串。
MONGO_URI=mongodb://mongodb:27017/intellihire

# 前端对外访问地址，用于 GitHub OAuth 回调。
FRONTEND_URL=http://127.0.0.1:8081

# 可选：阿里云 OSS（启用简历文件存储时配置）
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# 可选：GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TIMEOUT=
GITHUB_MAX_RETRIES=
HTTP_PROXY=

# 可选：QQ 邮箱 SMTP（发送面试邀请时配置）
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_USER=
QQ_SMTP_PASS=

# 可选：日志最低级别；未配置时为 http。
LOG_LEVEL=
