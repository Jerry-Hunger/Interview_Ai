# 服务端口
PORT=
# 云端 Atlas:
MONGO_URI=
# JWT 认证密钥
JWT_SECRET=
# DeepSeek API
DEEPSEEK_API_KEY=
# 阿里云 OSS
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_TIMEOUT=
GITHUB_MAX_RETRIES=

# HTTP Proxy for GitHub API (optional)
HTTP_PROXY=

# Frontend URL (required for GitHub OAuth redirect)
FRONTEND_URL=

# QQ 邮箱 SMTP (用于发送面试邀请邮件)
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=587
QQ_SMTP_USER=
QQ_SMTP_PASS=
# SOCKS5 代理配置（clash verge 需开启 SOCKS5 代理，默认端口 7897）
QQ_SMTP_PROXY_HOST=
QQ_SMTP_PROXY_PORT=