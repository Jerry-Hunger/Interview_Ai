# 本地运行服务端时的环境变量模板。
# 请填入 JWT_SECRET 和 DEEPSEEK_API_KEY；其余配置按实际启用的功能填写。

# 必填：应用安全与 AI 服务配置
JWT_SECRET=
DEEPSEEK_API_KEY=

# 服务端监听端口
PORT=5000

# 本地 MongoDB 连接；如使用 Atlas，请替换为对应连接字符串。
MONGO_URI=mongodb://127.0.0.1:27017/intellihire

# 可选：DeepSeek 请求超时（毫秒）与失败重试次数
DEEPSEEK_TIMEOUT=60000
DEEPSEEK_MAX_RETRIES=2

# 可选：阿里云 OSS（启用简历文件存储时配置）
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# 可选：GitHub OAuth
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TIMEOUT=30000
GITHUB_MAX_RETRIES=3
HTTP_PROXY=

# 可选：QQ 邮箱 SMTP（发送面试邀请时配置）
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_USER=
QQ_SMTP_PASS=

# 可选：日志最低级别
LOG_LEVEL=http
